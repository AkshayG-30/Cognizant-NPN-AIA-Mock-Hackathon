# CarePath AI Backend — Environment Configuration
# Copy this file to .env and fill in values

# Application
APP_NAME=CarePath AI
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=true
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://carepath:carepath_dev@localhost:5432/carepath_db
DATABASE_SYNC_URL=postgresql+psycopg2://carepath:carepath_dev@localhost:5432/carepath_db

# ML Model
WAIT_MODEL_PATH=../models/artifacts/wait_time_lgbm.txt
WAIT_MODEL_VERSION=v001
FEATURE_COLUMNS_PATH=../models/artifacts/feature_columns.json
SPECIALTY_ENCODER_PATH=../models/artifacts/specialty_encoder.json
SPECIALTY_PARAMS_PATH=../models/artifacts/specialty_params.json

# Master Dataset
MASTER_DATASET_DIR=../Datasets/master

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
AZURE_STORAGE_CONNECTION_STRING=

# Authentication
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# LLM (for clinical NLP — future)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

# Azure (production)
AZURE_POSTGRES_URL=
AZURE_BLOB_STORAGE_URL=
AZURE_APP_INSIGHTS_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
